{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Workers-AI",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/index.ts"
      ],
      "cwd": "${workspaceFolder}/apps/workers-ai",
      "sourceMaps": true, // Forzamos la lectura de mapas
      "smartStep": true,  // Salta código generado automáticamente
      "autoAttachChildProcesses": true, // CRUCIAL: tsx lanza procesos hijos
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug Landing (Full Stack)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/landing-next",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s"
      }
    },
    {
  "type": "node-terminal",
  "request": "launch",
  "name": "Debug API Gateway (Fixed)",
  "command": "npx tsx watch src/server.ts",
  "cwd": "${workspaceFolder}/apps/api-gateway",
  "env": {
    "NODE_ENV": "development"
  }
}
  ]
}