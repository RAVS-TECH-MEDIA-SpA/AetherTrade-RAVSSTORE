# ==============================================================================
# .gitignore - RAVSTORE MONOREPO (Next.js + AI Workers)
# ==============================================================================

# 1. DEPENDENCIAS (El peso pesado)
node_modules/
.pnpm-store/
jspm_packages/

# 2. CONSTRUCCIÓN Y CACHÉ (Lo que se genera solo)
.next/
dist/
build/
out/
.turbo/
.cache/
.tsbuildinfo

# 3. SCRIPTS Y TEMPORALES DE WORKERS
apps/workers-ai/*.js
apps/workers-ai/temp/
apps/workers-ai/output/
scripts/generated/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. SECRETOS Y CONFIGURACIONES (¡CRÍTICO!)
.env
.env.local
.env.production
.env.development
.env.*.local
*.pem
*.key

# 5. INFRAESTRUCTURA Y BASE DE DATOS LOCAL
infrastructure/db/data/
docker/volumes/

# 6. ARCHIVOS DE SQL Y VOLCADOS (Dumps de BD)
*.sql
*.dump

# 7. ARCHIVOS TEMPORALES Y DE NOTAS
Untitled-*.md
*.tmp

# 8. ARCHIVOS DE SISTEMA Y EDITORES
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 9. TESTING
coverage/
.nyc_output/

# 10. CREDENCIALES GCP Y OTROS
secrets/
env.yaml
apikey.txt