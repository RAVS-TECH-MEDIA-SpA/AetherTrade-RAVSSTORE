{
  "name": "aether-trade-monorepo",
  "version": "1.0.0",
  "description": "Sistema de Arbitraje Inteligente Ravstore",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:landing": "npm run dev -w apps/landing-next",
    "dev:workers": "npm run dev -w apps/workers-ai",
    "dev:api": "npm run dev -w apps/api-gateway",
    "build:all": "npm run build --workspaces",
    "fix:types": "npm install -D @types/node --workspaces",
    "test:all": "npm test --workspaces"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.12",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "ioredis": "^5.10.1",
    "ng2-charts": "^10.0.0"
  }
}
