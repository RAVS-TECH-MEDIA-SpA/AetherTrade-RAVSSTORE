# 1. ETAPA DE CONSTRUCCIÓN
FROM node:20-slim AS builder
WORKDIR /app

# Copiamos los package.json del ROOT y de la APP (Importante en Monorepos)
COPY package*.json ./
COPY apps/workers-ai/package*.json ./apps/workers-ai/

# Instalamos dependencias desde la raíz (para que NPM Workspaces funcione)
RUN npm install

# Copiamos el código de la app
COPY apps/workers-ai/ ./apps/workers-ai/

# Compilamos la app específica
WORKDIR /app/apps/workers-ai
RUN npx tsc

# 2. ETAPA DE EJECUCIÓN
FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copiamos solo lo necesario para ejecutar
COPY --from=builder /app/apps/workers-ai/package*.json ./
COPY --from=builder /app/apps/workers-ai/dist ./dist

# Instalamos solo dependencias de producción
RUN npm install --omit=dev

USER node
EXPOSE 8080
ENV PORT 8080
CMD ["npm", "start"]